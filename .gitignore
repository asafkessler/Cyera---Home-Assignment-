# ---------------------------------------------------------------------------
# Secrets - NEVER commit these.
#
# .env holds app-level secrets (encryption key, session secret, optional
# credentials for the blog-digest automation). Each developer / reviewer
# creates their own copy from .env.example, which IS committed and lists
# every variable name without values.
#
# Jira user credentials are NOT stored here at all: users enter them in the
# UI and the app stores them encrypted in its database (multi-tenant).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Build output
dist/
build/

# Local database (SQLite)
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test coverage
coverage/
