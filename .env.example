# ---------------------------------------------------------------------------
# IdentityHub Jira Integration - local configuration
#
# Copy this file to `.env` in the repository root and fill in the secrets.
# `.env` is ignored by git. Never commit real values.
#
# Note: Jira credentials are NOT configured here. Each user enters their own
# Jira site, email and API token in the app after logging in.
# ---------------------------------------------------------------------------

# development | production | test
APP_ENV=development

# Secrets. Generate both with:   cd backend && python -m app.keys
# APP_SECRET_KEY     signs session material; any random string of 32+ chars
# APP_ENCRYPTION_KEY encrypts stored Jira tokens; must be a Fernet key
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=

# Database. SQLite file by default (created automatically).
# For PostgreSQL:  DATABASE_URL=postgresql://user:password@host:5432/identityhub
#DATABASE_URL=sqlite:///./backend/data/identityhub.db

# Sessions
SESSION_TTL_HOURS=168
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Bonus: NHI Blog Digest automation (not needed for the web app)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
